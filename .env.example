# =============================================================
# SpendWise - Supabase Configuration
# =============================================================

# 1. Supabase PostgreSQL Database URI
# -------------------------------------------------------------
# You can find this in your Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI
#
# Option A (Recommended for serverless / cloud apps - Connection Pooler):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B (Direct Connection):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# (If left empty, SpendWise falls back to local SQLite 'spendwise.db')
DATABASE_URL=

# 2. Supabase API Credentials (Optional - for Supabase Python SDK / Storage / Auth)
# -------------------------------------------------------------
# Found in: Project Settings -> API
# - Project URL: https://[YOUR-PROJECT-REF].supabase.co
# - anon public key or service_role secret key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 3. Flask Security
# -------------------------------------------------------------
SECRET_KEY=spendwise_super_secret_key_2026
